rules_version = '2';
// Rooms only hold what two phones need to find each other: the 4-letter code, the river,
// who is in the room, and the WebRTC offer/answer. The race and voice go phone to phone.
service cloud.firestore {
  match /databases/{database}/documents {
    function small() {
      return request.resource.data.keys().size() <= 12;
    }
    // The admin panel (website): signed in with Google, and that Google account has a document admins/{its auth uid}.
    // Phones never sign in, so for them this is simply false and costs no extra read.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Who may use the admin panel. Added by hand in the Firebase console only; the panel itself can never add an admin.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // What was done in the admin panel, newest first. Never edited.
    match /admin_log/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    // One document, config/app, says which version must update. Players only read it; it is edited in the console.
    match /config/{doc} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Ranked: one document per player and season, ranked_s{season}/{player id}, read by everyone for the top 100.
    match /{season}/{uid} {
      allow get, list: if season.matches('^ranked_s[0-9]+$');
      allow create, update: if season.matches('^ranked_s[0-9]+$') && uid.matches('^[1-9][0-9]{7}$') && small()
        && request.resource.data.get('name', '').size() <= 40 && request.resource.data.get('score', '').matches('^[0-9]{7}$');
      allow delete: if false;
    }
    // Official partners and creators: a document partners/{player id} gives that player the
    // "Hippo Raft Rush Official Partner" title. Phones only read their own; it is added in the console.
    match /partners/{uid} {
      allow get: if uid.matches('^[1-9][0-9]{7}$');
      allow list, write: if isAdmin();
    }
    // Profile photos from the gallery, seen by everyone: photos/{player id} with pic (a small JPEG in base64, "" for none)
    // and at. A player in photo_bans (added in the console) can't set one. Reports go to photo_reports for the console.
    match /photos/{uid} {
      allow get: if uid.matches('^[1-9][0-9]{7}$');
      allow create, update: if uid.matches('^[1-9][0-9]{7}$')
        && !exists(/databases/$(database)/documents/photo_bans/$(uid))
        && request.resource.data.keys().hasOnly(['pic', 'at'])
        && request.resource.data.pic is string && request.resource.data.pic.size() < 60000;
      allow list: if false;
      allow delete: if isAdmin();
    }
    match /photo_bans/{uid} {
      allow read, write: if isAdmin();
    }
    match /photo_reports/{report} {
      allow create: if report.matches('^[1-9][0-9]{7}_[1-9][0-9]{7}$')
        && request.resource.data.keys().hasOnly(['target', 'by', 'at'])
        && request.resource.data.target.matches('^[1-9][0-9]{7}$');
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Old saves, by public player id: read once to move them into the vault, and never written again.
    match /saves/{uid} {
      allow get: if uid.matches('^[1-9][0-9]{7}$');
      allow list, create, update, delete: if false;
    }
    // The player's progress (Pearls, Bubbles, shop items, look, ranked, stats, settings) as one string, so deleting the game
    // and installing it again brings it back. The document id is a private hash only that phone can work out; nobody lists them.
    match /vault/{key} {
      allow get: if key.matches('^[0-9a-f]{64}$');
      allow create, update: if key.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['data', 'at', 'v'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000;
      allow list, delete: if false;
    }
    // Mail from "Hippo Raft Rush Official", written only in the console: mail/{any id} with to (a player id, or
    // partners, creators or all), title, message, pearls, bubbles. Phones read it; nobody can write it from a phone.
    match /mail/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    // A gift collected: mail_claims/{mail id}_{player id}, written once and never changed, so each gift is taken once.
    match /mail_claims/{claim} {
      allow get: if claim.matches('^[A-Za-z0-9_-]{1,60}_[1-9][0-9]{7}$');
      allow create: if claim.matches('^[A-Za-z0-9_-]{1,60}_[1-9][0-9]{7}$')
        && request.resource.data.keys().hasOnly(['at']);
      allow list: if isAdmin();
      allow update, delete: if false;
    }
    // Players and their friends. A player is an 8 digit id; each has a profile (name, look, last seen, at home or which river),
    // a list of friends and an inbox of friend requests and crew invites. Phones poll these; nothing is listed across players.
    match /users/{uid} {
      function id(x) { return x.matches('^[1-9][0-9]{7}$'); }
      allow get: if id(uid);
      allow list: if isAdmin();
      allow create, update: if id(uid) && small()
        && request.resource.data.get('name', '').size() <= 40;
      allow delete: if false;

      match /friends/{friend} {
        allow read: if id(uid);
        allow create, update: if id(uid) && id(friend) && small();
        allow delete: if true;
      }
      match /inbox/{item} {
        allow read: if id(uid);
        allow create, update: if id(uid) && small()
          && request.resource.data.kind in ['friend', 'invite', 'accepted', 'removed', 'reply']
          && id(request.resource.data.from)
          && request.resource.data.get('name', '').size() <= 40;
        allow delete: if true;
      }
    }

    // ADD FRIEND's list: a small public card per player, so people can find each other. Only the newest few can be read at once.
    match /discover/{uid} {
      allow list: if request.query.limit <= 40;
      allow get, delete: if false;
      allow create, update: if uid.matches('^[1-9][0-9]{7}$')
        && request.resource.data.keys().hasOnly(['name', 'seen', 'level', 'avatar', 'frame', 'rp'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.seen.matches('^[0-9]{10}$');
    }

    // Which player id a phone had, so deleting and installing the game again keeps the id. The key is a hash of the
    // phone's own id. Written once, never changed, so nobody can point someone else's phone at another id.
    match /devices/{device} {
      allow get: if device.matches('^[0-9a-f]{64}$');
      allow list, update, delete: if false;
      allow create: if device.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid.matches('^[1-9][0-9]{7}$');
    }

    // WOW RACE: rivers made by players. A player asks once (wow_apply); the answers are read in the console, where
    // adding wow_creators/{player id} lets that player publish, and setting status "denied" on the answers turns them down.
    // Phones never change wow_apply or wow_creators after that.
    match /wow_apply/{uid} {
      allow get: if uid.matches('^[1-9][0-9]{7}$');
      allow list, update, delete: if isAdmin();
      allow create: if uid.matches('^[1-9][0-9]{7}$')
        && request.resource.data.keys().hasOnly(['name', 'q1', 'q2', 'q3', 'q4', 'q5', 'at', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.get('name', '').size() <= 40
        && request.resource.data.q1.size() <= 200 && request.resource.data.q2.size() <= 200 && request.resource.data.q3.size() <= 200
        && request.resource.data.q4.size() <= 200 && request.resource.data.q5.size() <= 200;
    }
    match /wow_creators/{uid} {
      allow get: if uid.matches('^[1-9][0-9]{7}$');
      allow list, write: if isAdmin();
    }
    // A river's card: its id is the creator's player id and a number. Only a creator writes the card itself; anyone adds
    // one play at a time, and one rating at a time (a rating document of their own goes with it).
    match /wow_rivers/{rid} {
      function creator(uid) { return exists(/databases/$(database)/documents/wow_creators/$(uid)); }
      function mine() {
        return rid.matches('^[1-9][0-9]{7}_[0-9]{1,2}$') && request.resource.data.uid == rid.split('_')[0] && creator(request.resource.data.uid);
      }
      function card() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'creator', 'title', 'desc', 'style', 'thumb', 'plays', 'rsum', 'rcount', 'at', 'ver'])
          && d.title.size() >= 1 && d.title.size() <= 24 && d.get('desc', '').size() <= 140 && d.get('creator', '').size() <= 40
          && d.thumb.size() <= 150000 && d.style.matches('^[0-9]$') && d.plays.matches('^[0-9]{7}$');
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow get, list: if true;
      allow create: if mine() && card() && request.resource.data.plays == '0000000'
        && request.resource.data.rsum == '0' && request.resource.data.rcount == '0';
      allow update: if (mine() && card() && changed().hasOnly(['creator', 'title', 'desc', 'style', 'thumb', 'at', 'ver']))
        || (changed().hasOnly(['plays']) && request.resource.data.plays.matches('^[0-9]{7}$')
            && int(request.resource.data.plays) == int(resource.data.plays) + 1)
        || (changed().hasOnly(['rsum', 'rcount']) && int(request.resource.data.rcount) == int(resource.data.rcount) + 1
            && int(request.resource.data.rsum) - int(resource.data.rsum) >= 1 && int(request.resource.data.rsum) - int(resource.data.rsum) <= 5);
      // its creator can take a river away for good (the card goes first; then its map, stars and comments can go)
      allow delete: if (rid.matches('^[1-9][0-9]{7}_[0-9]{1,2}$') && creator(rid.split('_')[0])) || isAdmin();

      match /ratings/{uid} {
        allow read: if true;
        allow create: if uid.matches('^[1-9][0-9]{7}$') && request.resource.data.keys().hasOnly(['stars'])
          && request.resource.data.stars.matches('^[1-5]$');
        allow update: if false;
        allow delete: if !exists(/databases/$(database)/documents/wow_rivers/$(rid)) || isAdmin();
      }
      match /comments/{cid} {
        allow read: if true;
        allow create: if cid.matches('^[0-9]{13}_[1-9][0-9]{7}$')
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == cid.split('_')[1]
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 140
          && request.resource.data.get('name', '').size() <= 40;
        allow update: if false;
        allow delete: if !exists(/databases/$(database)/documents/wow_rivers/$(rid)) || isAdmin();
      }
    }
    // The river itself, as the editor saved it. Read when someone plays it; written with its card.
    match /wow_maps/{rid} {
      allow get: if true;
      allow list: if false;
      allow delete: if !exists(/databases/$(database)/documents/wow_rivers/$(rid)) || isAdmin();   // only once its card is gone
      allow create, update: if rid.matches('^[1-9][0-9]{7}_[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['uid', 'data'])
        && request.resource.data.uid == rid.split('_')[0]
        && exists(/databases/$(database)/documents/wow_creators/$(request.resource.data.uid))
        && request.resource.data.data.size() <= 60000;
    }
    // Reports of a river or a comment, read in the console.
    match /wow_reports/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['rid', 'cid', 'uid', 'why']) && small()
        && request.resource.data.rid.size() <= 20 && request.resource.data.get('cid', '').size() <= 40;
    }

    // HELP & SUPPORT: a phone writes one message, once; only the admin panel can read or answer it.
    match /support/{id} {
      allow create: if id.matches('^[1-9][0-9]{7}_[0-9]{13}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'topic', 'message', 'status', 'at', 'version', 'device', 'os', 'country', 'language', 'level', 'pass', 'screen'])
        && request.resource.data.uid == id.split('_')[0] && request.resource.data.status == 'open'
        && request.resource.data.topic in ['BUG', 'PAYMENT', 'ADS', 'ACCOUNT', 'IDEA', 'OTHER']
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 800
        && request.resource.data.get('name', '').size() <= 40 && request.resource.data.get('device', '').size() <= 60 && request.resource.data.get('os', '').size() <= 60;
      allow read, update, delete: if isAdmin();
    }
    // Analytics: phones add to their own counters, a limited amount each time, and can't read anyone's; the admin panel reads them.
    function isId(x) { return x.matches('^[1-9][0-9]{7}$'); }
    function before(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    function grows(f, most) {
      let v = request.resource.data.get(f, 0);
      return v is int && v >= before(f) && v - before(f) <= most;
    }
    function counters() {
      return grows('seconds', 3600) && grows('sessions', 20) && grows('races', 100) && grows('ads', 800)
        && grows('rewarded', 200) && grows('interstitial', 200) && grows('banner', 200) && grows('native', 200);
    }
    function oneMore() { return request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n == before('n') + 1; }
    function dimKey(k) { return k.matches('^c_[A-Z]{2}$') || k.matches('^v_[0-9.]{1,12}$'); }
    function dayField(f) { return !(f in request.resource.data) || (request.resource.data[f] is int && request.resource.data[f] >= 0 && request.resource.data[f] <= 99991231); }
    match /stats_players/{uid} {
      allow read: if isAdmin();
      allow delete: if false;
      allow create, update: if isId(uid) && counters() && dayField('firstDay') && dayField('lastDay')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'country', 'version', 'level', 'firstDay', 'lastDay', 'lastAt', 'seconds', 'sessions', 'races', 'ads', 'rewarded', 'interstitial', 'banner', 'native'])
        && request.resource.data.uid == uid && request.resource.data.get('name', '').size() <= 40 && request.resource.data.country.matches('^[A-Z]{2}$');
    }
    match /stats_all/{key} {
      allow read: if isAdmin();
      allow create, update: if key.matches('^c_[A-Z]{2}$') && oneMore();
      allow delete: if false;
    }
    match /stats_days/{day} {
      match /players/{uid} {
        allow read: if isAdmin();
        allow delete: if false;
        allow create, update: if day.matches('^20[0-9]{6}$') && isId(uid) && counters() && dayField('firstDay')
          && request.resource.data.keys().hasOnly(['uid', 'country', 'firstDay', 'new', 'seconds', 'sessions', 'races', 'ads', 'rewarded', 'interstitial', 'banner', 'native'])
          && request.resource.data.uid == uid && request.resource.data.country.matches('^[A-Z]{2}$') && request.resource.data.get('new', 0) in [0, 1];
      }
      match /dims/{key} {
        allow read: if isAdmin();
        allow create, update: if day.matches('^20[0-9]{6}$') && dimKey(key) && oneMore();
        allow delete: if false;
      }
    }
    // One minute of play (India time) for the admin panel's live graphs, in ten shards so a busy minute isn't one hot
    // document: phones that reported in it, and what they added. Counters only, and each only grows a little.
    match /stats_minutes/{key} {
      allow read: if isAdmin();
      allow delete: if false;
      allow create, update: if key.matches('^20[0-9]{10}_[0-9]$')
        && request.resource.data.keys().hasOnly(['players', 'seconds', 'races', 'ads'])
        && grows('players', 1) && grows('seconds', 3600) && grows('races', 100) && grows('ads', 800);
    }
    match /stats_months/{month} {
      match /players/{uid} {
        allow read: if isAdmin();
        allow create: if month.matches('^20[0-9]{4}$') && isId(uid) && request.resource.data.keys().hasOnly(['day']) && request.resource.data.day is int;
        allow update, delete: if false;
      }
      match /dims/{key} {
        allow read: if isAdmin();
        allow create, update: if month.matches('^20[0-9]{4}$') && key.matches('^c_[A-Z]{2}$') && oneMore();
        allow delete: if false;
      }
    }

    match /rooms/{code} {
      allow get: if code.matches('^[A-Z]{4}$');
      allow list: if false;
      allow create, update: if code.matches('^[A-Z]{4}$') && small();
      allow delete: if true;

      match /peers/{peer} {
        allow read: if true;
        allow create, update: if small();
        allow delete: if true;
      }
      match /links/{link} {
        allow read: if true;
        allow create, update: if small()
          && (!('offer' in request.resource.data) || request.resource.data.offer.size() < 30000)
          && (!('answer' in request.resource.data) || request.resource.data.answer.size() < 30000);
        allow delete: if true;
      }
    }
  }
}
